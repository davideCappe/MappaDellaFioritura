@using MDF.Components.Account.Shared
@using MDF.Shared.Constants

<nav class="admin-nav" aria-label="Navigazione area riservata">
    <a href="/" class="admin-brand-link">
        <img src="/images/logo.webp" alt="" class="admin-brand-logo" />
        <span>Mappa della Fioritura<small>Area riservata</small></span>
    </a>

    <details class="admin-menu" open>
        <summary>Menu area riservata</summary>
        <div class="admin-menu-body">
            <AuthorizeView Roles="@(Roles.Admin + "," + Roles.SuperAdmin)">
                <Authorized>
                    <section class="admin-nav-group" aria-labelledby="admin-navigation-title">
                        <h2 id="admin-navigation-title" class="admin-nav-heading">Amministrazione</h2>
                        <ul class="admin-nav-links">
                            <li><NavLink href="/admin/dashboard" Match="NavLinkMatch.All" class="admin-nav-link">Dashboard</NavLink></li>
                            <li><NavLink href="/admin/clienti" class="admin-nav-link">Clienti</NavLink></li>
                            <li><NavLink href="/admin/contenuti" class="admin-nav-link">Contenuti</NavLink></li>
                            <li><NavLink href="/admin/utenti/nuovo" class="admin-nav-link">Crea utente</NavLink></li>
                        </ul>
                    </section>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized>
                    <section class="admin-nav-group" aria-labelledby="account-navigation-title">
                        <h2 id="account-navigation-title" class="admin-nav-heading">Il mio account</h2>
                        <ManageNavMenu />
                    </section>
                </Authorized>
            </AuthorizeView>

            <div class="admin-nav-actions">
                <a href="/" class="admin-site-link">Torna al sito pubblico</a>
                <AuthorizeView>
                    <Authorized>
                        <form method="post" action="/Account/Logout" class="admin-logout-form">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="/" />
                            <button type="submit" class="admin-logout-button">Esci dall'account</button>
                        </form>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </details>
</nav>
