@implements IAsyncDisposable
@inject IJSRuntime JS

<a @ref="backToTopElement" class="back-to-top" href="#top" aria-label="Torna all'inizio della pagina">Torna su</a>

@code {
    private IJSObjectReference? module;
    private ElementReference backToTopElement;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Layout/BackToTop.razor.js");
        await module.InvokeVoidAsync("initializeBackToTop", backToTopElement);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.InvokeVoidAsync("disposeBackToTop");
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
