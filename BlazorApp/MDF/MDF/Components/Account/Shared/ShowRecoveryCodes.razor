<StatusMessage Message="@StatusMessage" />
<h3>Codici di recupero</h3>
<div class="alert alert-warning" role="alert">
    <p><strong>Copia questi codici e conservali in un luogo sicuro, separato dal dispositivo.</strong></p>
    <p>Ogni codice puo essere usato una sola volta. Senza dispositivo e codici di recupero potresti perdere l'accesso al tuo account.</p>
</div>
<ul class="account-recovery-codes" aria-label="Codici di recupero da conservare">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <li><code class="recovery-code">@recoveryCode</code></li>
    }
</ul>
<a href="/Account/Manage/TwoFactorAuthentication" class="btn btn-secondary">Torna alla sicurezza dell'account</a>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
