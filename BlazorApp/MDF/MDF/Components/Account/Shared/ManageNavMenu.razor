@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager

<ul class="admin-nav-links">
    <li>
        <NavLink class="admin-nav-link" href="/Account/Manage" Match="NavLinkMatch.All">Profilo</NavLink>
    </li>
    <li>
        <NavLink class="admin-nav-link" href="/Account/Manage/Email">Email</NavLink>
    </li>
    <li>
        <NavLink class="admin-nav-link" href="/Account/Manage/ChangePassword">Password</NavLink>
    </li>
    @if (hasExternalLogins)
    {
        <li>
            <NavLink class="admin-nav-link" href="/Account/Manage/ExternalLogins">Accessi esterni</NavLink>
        </li>
    }
    <li>
        <NavLink class="admin-nav-link" href="/Account/Manage/TwoFactorAuthentication">Autenticazione a due fattori</NavLink>
    </li>
    <li>
        <NavLink class="admin-nav-link" href="/Account/Manage/Passkeys">Passkey</NavLink>
    </li>
    <li>
        <NavLink class="admin-nav-link" href="/Account/Manage/PersonalData">Dati personali</NavLink>
    </li>
</ul>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
