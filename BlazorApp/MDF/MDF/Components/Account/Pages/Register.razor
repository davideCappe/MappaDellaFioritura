@page "/admin/utenti/nuovo"
@page "/Account/Register"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Roles.Admin + "," + Roles.SuperAdmin)]

@using System.ComponentModel.DataAnnotations
@using MDF.Shared.Constants
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@inject ILogger<Register> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Area riservata | Crea utente</PageTitle>

<section class="admin-panel">
    <p class="admin-kicker">Amministrazione</p>
    <h1 class="admin-page-title">Crea utente</h1>
    <p class="admin-lead">Crea un nuovo account senza interrompere la tua sessione di lavoro.</p>
</section>

<section class="admin-panel create-user-panel">
    <StatusMessage />
    @if (errorMessage is not null)
    {
        <div class="admin-alert admin-alert-error" role="alert">@errorMessage</div>
    }
    <EditForm Model="Input" method="post" OnValidSubmit="CreateUserAsync" FormName="create-user" class="admin-form">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />
        <div class="admin-field">
            <label for="new-user-email">Email</label>
            <InputText type="email" @bind-Value="Input.Email" id="new-user-email" class="admin-input" autocomplete="off" aria-required="true" />
            <ValidationMessage For="() => Input.Email" />
        </div>
        <div class="admin-field">
            <label for="new-user-password">Password</label>
            <InputText type="password" @bind-Value="Input.Password" id="new-user-password" class="admin-input" autocomplete="new-password" aria-required="true" aria-describedby="new-user-password-help" />
            <p id="new-user-password-help" class="admin-helper">@PasswordRequirements</p>
            <ValidationMessage For="() => Input.Password" />
        </div>
        <div class="admin-field">
            <label for="new-user-confirm-password">Conferma password</label>
            <InputText type="password" @bind-Value="Input.ConfirmPassword" id="new-user-confirm-password" class="admin-input" autocomplete="new-password" aria-required="true" />
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>
        <div class="admin-field">
            <label for="new-user-role">Ruolo</label>
            <InputSelect @bind-Value="Input.Role" id="new-user-role" class="admin-select" aria-describedby="new-user-role-help">
                <option value="@Roles.User">Utente</option>
                @if (HttpContext.User.IsInRole(Roles.SuperAdmin))
                {
                    <option value="@Roles.Admin">Admin</option>
                }
            </InputSelect>
            <p id="new-user-role-help" class="admin-helper">Un utente gestisce solo il proprio account. Un Admin gestisce anche clienti e contenuti e crea utenti standard.</p>
        </div>
        <p class="admin-helper">L'account viene attivato con email confermata dall'amministratore, senza invio di email. Verifica l'indirizzo e comunica le credenziali in modo sicuro.</p>
        <div class="admin-actions">
            <button type="submit" class="admin-button">Crea utente</button>
            <a href="/admin/dashboard" class="admin-button admin-button-secondary">Annulla</a>
        </div>
    </EditForm>
</section>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "create-user")]
    private InputModel Input { get; set; } = default!;

    private string PasswordRequirements
    {
        get
        {
            var options = UserManager.Options.Password;
            var requirements = new List<string> { $"almeno {options.RequiredLength} caratteri" };
            if (options.RequireUppercase) requirements.Add("una lettera maiuscola");
            if (options.RequireLowercase) requirements.Add("una lettera minuscola");
            if (options.RequireDigit) requirements.Add("un numero");
            if (options.RequireNonAlphanumeric) requirements.Add("un carattere speciale");
            if (options.RequiredUniqueChars > 1) requirements.Add($"{options.RequiredUniqueChars} caratteri distinti");
            return $"La password deve contenere {string.Join(", ", requirements)}.";
        }
    }

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task CreateUserAsync()
    {
        if (!HttpContext.User.IsInRole(Roles.Admin) && !HttpContext.User.IsInRole(Roles.SuperAdmin))
        {
            errorMessage = "Non sei autorizzato a creare utenti.";
            Logger.LogWarning("Unauthorized attempt to create a user.");
            return;
        }

        if (Input.Role != Roles.User && !(Input.Role == Roles.Admin && HttpContext.User.IsInRole(Roles.SuperAdmin)))
        {
            errorMessage = "Non sei autorizzato ad assegnare il ruolo selezionato.";
            Logger.LogWarning("User {AdministratorId} attempted to assign an unauthorized role.", UserManager.GetUserId(HttpContext.User));
            return;
        }

        var strategy = DbContext.Database.CreateExecutionStrategy();
        var result = await strategy.ExecuteAsync(async () =>
        {
            // Each retry must start with a new user instance and no rolled-back tracked changes.
            DbContext.ChangeTracker.Clear();
            await using var transaction = await DbContext.Database.BeginTransactionAsync();
            var user = new ApplicationUser
            {
                UserName = Input.Email.Trim(),
                Email = Input.Email.Trim(),
                EmailConfirmed = true
            };
            var createResult = await UserManager.CreateAsync(user, Input.Password);
            if (!createResult.Succeeded)
            {
                return createResult;
            }

            var roleResult = await UserManager.AddToRoleAsync(user, Input.Role);
            if (!roleResult.Succeeded)
            {
                return roleResult;
            }

            await transaction.CommitAsync();
            Logger.LogInformation("Administrator {AdministratorId} created user {UserId} with role {Role}.",
                UserManager.GetUserId(HttpContext.User), user.Id, Input.Role);
            return IdentityResult.Success;
        });

        if (!result.Succeeded)
        {
            errorMessage = string.Join(" ", result.Errors.Select(error => error.Description));
            Logger.LogWarning("User creation failed: {Errors}", errorMessage);
            return;
        }

        RedirectManager.RedirectToWithStatus("admin/utenti/nuovo", "Utente creato. L'account e attivo e puo accedere con le credenziali impostate.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Inserisci l'email.")]
        [EmailAddress(ErrorMessage = "Inserisci un indirizzo email valido.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Inserisci la password.")]
        [StringLength(100, ErrorMessage = "La password deve contenere da {2} a {1} caratteri.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Conferma la password.")]
        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Le password non coincidono.")]
        public string ConfirmPassword { get; set; } = "";

        [Required]
        public string Role { get; set; } = Roles.User;
    }
}
