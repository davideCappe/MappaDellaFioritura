@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Dati personali</PageTitle>

<StatusMessage />
<h3>I tuoi dati personali</h3>
<p class="account-description">Puoi scaricare una copia dei dati associati al tuo account o richiederne l'eliminazione.</p>

<div class="account-callout">
    <h4>Scarica i tuoi dati</h4>
    <p>Conserva una copia delle informazioni del tuo profilo in formato JSON.</p>
    <form action="Account/Manage/DownloadPersonalData" method="post">
        <AntiforgeryToken />
        <button class="btn btn-primary" type="submit">Scarica dati personali</button>
    </form>
</div>
<div class="account-callout account-callout-danger">
    <h4>Elimina il tuo account</h4>
    <p><strong>L'eliminazione dei dati rimuove definitivamente il tuo account. Questa operazione non puo essere annullata.</strong></p>
    <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Procedi con l'eliminazione</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
