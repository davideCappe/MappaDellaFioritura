@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Autenticazione a due fattori</PageTitle>

<StatusMessage />
<h3>Autenticazione a due fattori</h3>
<p class="account-description">Aggiungi una verifica con un'app di autenticazione per proteggere l'accesso al tuo account.</p>
<span class="account-badge">@(is2faEnabled ? "Protezione attiva" : "Protezione non attiva")</span>
@if (canTrack)
{
    if (is2faEnabled)
    {
        <div class="account-callout">
            <h4>Codici di recupero</h4>
            <p>Codici disponibili: <strong>@recoveryCodesLeft</strong>. Usali se non puoi accedere alla tua app di autenticazione.</p>
            @if (recoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning" role="alert">
                    <strong>@(recoveryCodesLeft == 0 ? "Non hai piu codici di recupero." : "I codici di recupero stanno per terminare.")</strong>
                    <p>Genera nuovi codici e conservali in un luogo sicuro.</p>
                </div>
            }
            <a href="Account/Manage/GenerateRecoveryCodes" class="btn btn-secondary">Genera nuovi codici</a>
        </div>
        @if (isMachineRemembered)
        {
            <div class="account-callout">
                <h4>Browser attendibile</h4>
                <p>Questo browser non richiede il codice a ogni accesso. Puoi revocare questa preferenza.</p>
                <form @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-secondary">Rimuovi questo browser dai dispositivi attendibili</button>
                </form>
            </div>
        }
    }

    <div class="account-callout">
        <h4>App di autenticazione</h4>
        <p>Usa un'app come Microsoft Authenticator o Google Authenticator per generare i codici di accesso.</p>
        <div class="account-actions">
            <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">@(hasAuthenticator ? "Configura app" : "Aggiungi app")</a>
            @if (hasAuthenticator)
            {
                <a href="Account/Manage/ResetAuthenticator" class="btn btn-secondary">Reimposta app</a>
            }
            @if (is2faEnabled)
            {
                <a href="Account/Manage/Disable2fa" class="btn btn-danger">Disattiva verifica a due fattori</a>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-danger" role="alert">
        <strong>Informativa privacy e cookie non accettata.</strong>
        <p>Accetta l'informativa prima di attivare l'autenticazione a due fattori.</p>
    </div>
}

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "Browser rimosso dai dispositivi attendibili. Al prossimo accesso da questo browser dovrai inserire il codice di verifica.",
            HttpContext);
    }
}
