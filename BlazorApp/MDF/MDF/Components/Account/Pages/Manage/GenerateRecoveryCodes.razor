@page "/Account/Manage/GenerateRecoveryCodes"

@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<GenerateRecoveryCodes> Logger

<PageTitle>Genera codici di recupero</PageTitle>

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <h3>Genera nuovi codici di recupero</h3>
    <div class="alert alert-warning" role="alert">
        <p><strong>I nuovi codici sostituiranno quelli precedenti. Conservali in un luogo sicuro.</strong></p>
        <p>Se perdi il dispositivo e non hai i codici di recupero, potresti perdere l'accesso al tuo account.</p>
        <p>Questa operazione non modifica la chiave dell'app. Per cambiarla, <a href="Account/Manage/ResetAuthenticator">reimposta l'app di autenticazione</a>.</p>
    </div>
    <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <div class="account-actions">
            <button class="btn btn-primary" type="submit">Genera nuovi codici</button>
            <a href="/Account/Manage/TwoFactorAuthentication" class="btn btn-secondary">Annulla</a>
        </div>
    </form>
}

@code {
    private string? message;
    private ApplicationUser? user;
    private IEnumerable<string>? recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var isTwoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        if (!isTwoFactorEnabled)
        {
            throw new InvalidOperationException("Cannot generate recovery codes for user because they do not have 2FA enabled.");
        }
    }

    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
        message = "Nuovi codici di recupero generati correttamente.";

        Logger.LogInformation("User with ID '{UserId}' has generated new 2FA recovery codes.", userId);
    }
}
