@page "/admin"
@page "/admin/dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using MDF.Shared.Constants
@layout AdminLayout
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.SuperAdmin)]

<PageTitle>Back Office | Dashboard</PageTitle>

<div class="admin-dashboard-page">
    <section class="admin-panel admin-dashboard-hero">
        <p class="admin-kicker">Area amministrazione</p>
        <h1 class="admin-page-title">Dashboard</h1>
        <p class="admin-lead">
            Gestisci clienti, contenuti e nuovi utenti dal menu Amministrazione. In Il mio account trovi il profilo e le impostazioni di sicurezza del tuo accesso.
        </p>
    </section>

    <section class="admin-link-grid admin-dashboard-grid">
        <article class="admin-panel">
            <h2 class="admin-section-title">Flusso consigliato</h2>
            <ol class="admin-dashboard-list">
                <li>Crea o aggiorna il cliente in <strong>Clienti</strong>.</li>
                <li>Verifica PublicId e route pubblica prevista.</li>
                <li>Carica PDF e tracce in <strong>Contenuti</strong>.</li>
                <li>Ordina le tracce e controlla la pagina pubblica finale.</li>
            </ol>
        </article>

        <article class="admin-panel">
            <h2 class="admin-section-title">Regole contenuti</h2>
            <ul class="admin-dashboard-list">
                <li>Un solo PDF per cliente (l'upload successivo sostituisce il precedente).</li>
                <li>Ogni traccia audio richiede titolo e ordinamento esplicito.</li>
                <li>I file sono salvati nella cartella nominata con il <strong>PublicId</strong>.</li>
                <li>La pubblicazione dipende dallo stato <strong>Cliente attivo</strong>.</li>
            </ul>
        </article>
    </section>
</div>
