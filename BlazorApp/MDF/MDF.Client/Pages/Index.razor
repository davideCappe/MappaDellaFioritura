@page "/"
@rendermode InteractiveAuto
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Mappa della Fioritura | Mappa personale e consapevolezza</PageTitle>

<HeadContent>
    <meta name="description" content="Scopri la Mappa della Fioritura: uno strumento di consapevolezza basato sulla data di nascita per comprendere talenti, identità e relazioni.">
    <link rel="canonical" href="https://mappadellafioritura.it/">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Mappa della Fioritura">
    <meta property="og:description" content="Uno strumento di consapevolezza basato sulla data di nascita per comprendere talenti, identità e relazioni.">
    <meta property="og:url" content="https://mappadellafioritura.it/">
    <meta property="og:image" content="https://mappadellafioritura.it/images/social-preview.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://mappadellafioritura.it/images/social-preview.png">
    <link rel="icon" type="image/webp" href="images/logo.webp">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&amp;family=Manrope:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/style.css">
    <link rel="alternate" hreflang="it" href="https://mappadellafioritura.it/index.html">
    <link rel="alternate" hreflang="en" href="https://mappadellafioritura.it/en/index.html">
    <link rel="alternate" hreflang="x-default" href="https://mappadellafioritura.it/index.html">
</HeadContent>

<a class="skip-link" href="#contenuto">Salta al contenuto</a>

<div class="ambient" aria-hidden="true">
    <span class="blob blob-a"></span>
    <span class="blob blob-b"></span>
    <span class="blob blob-c"></span>
    <span class="grain"></span>
</div>

<div class="app">
    <MainNav ActivePage="Mappa" EnglishHref="en/index.html" />

    <div id="page-content" class="page-content">
        <header class="app-header reveal" id="top">
            <div class="brand-mark" aria-hidden="true">
                <img src="images/logo.webp" alt="" class="brand-logo">
            </div>
            <h1>Mappa della Fioritura </h1>
            <a class="hero-cta" href="#calcolo">Calcola la tua mappa</a>
        </header>

        <main class="experience" id="contenuto">
            <section class="tool-shell reveal" id="calcolo">
                <section class="input-panel">
                    <h2>Calcolo personale</h2>
                    <p class="panel-intro">Inserisci i dati principali e genera la tua mappa in pochi secondi.</p>
                    <fieldset class="field profile-choice">
                        <legend class="visually-hidden">Descrizione per</legend>
                        <div class="choice-options">
                            <label class="choice-option">
                                <input type="radio" name="profilo" value="adulto" checked>
                                <span>Adulto</span>
                            </label>
                            <label class="choice-option">
                                <input type="radio" name="profilo" value="bambino">
                                <span>Bambino</span>
                            </label>
                        </div>
                    </fieldset>

                    <div class="field">
                        <label for="nome">Nome</label>
                        <input type="text" id="nome" placeholder="Nome" autocomplete="name" required>
                    </div>

                    <div class="field">
                        <label for="dataNascita">Data di nascita</label>
                        <input type="date" id="dataNascita" required>
                    </div>

                    <div class="actions-row">
                        <button id="btnCalcola" type="button">Calcola</button>
                        <button id="btnExport" type="button" class="btn-secondary">Export PNG</button>
                    </div>

                    <div class="input-summary" id="riepilogoPersona" aria-live="polite" hidden>
                        <p class="age-display">Età: <strong id="etaPersona"></strong></p>
                    </div>

                    <p id="errore" class="errore" role="alert" aria-live="assertive" hidden></p>
                </section>

                <section class="matrix-panel is-locked" aria-hidden="true">
                    <div class="matrix-container">
                        <div class="matrix-lock-message" aria-live="polite">
                            <div class="matrix-lock-mark" aria-hidden="true">
                                <img src="images/logo.webp" alt="">
                            </div>
                            <p class="matrix-lock-kicker">La tua mappa</p>
                            <p class="matrix-lock-title">Pronta a fiorire</p>
                            <p class="matrix-lock-copy" data-lock-message>Premi Calcola per rivelare la tua mappa</p>
                        </div>
                        <svg id="matrixSvg" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
                            <image href="images/ITAmatrice.webp" x="0" y="0" width="1000" height="1000" />
                            <g id="logoOverlay" opacity="0.3" pointer-events="none">
                                <image href="images/logo.webp" x="325" y="325" width="350" height="350" preserveAspectRatio="xMidYMid meet" />
                            </g>
                            <g id="numeriLayer"></g>
                        </svg>
                    </div>
                </section>
            </section>

            <section class="comfort-panel reveal" id="descrizioneCentro" aria-live="polite" hidden>
                <p class="comfort-kicker">Il tuo centro</p>
                <h2 id="comfortTitolo"></h2>
                <p id="comfortTesto"></p>
            </section>

            <section class="insights-panel reveal" id="approfondimentiMappa" aria-live="polite" hidden>
                <section class="health-card" aria-labelledby="tesseraTitolo">
                    <div class="section-heading">
                        <p class="comfort-kicker">Lettura personale</p>
                        <h2 id="tesseraTitolo">Tessera Sanitaria</h2>
                    </div>
                    <div class="health-table-wrap">
                        <table class="health-table">
                            <thead>
                                <tr>
                                    <th scope="col">Nome dei Chakra</th>
                                    <th scope="col">Fisica</th>
                                    <th scope="col">Energia</th>
                                    <th scope="col">Emozioni</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th scope="row">7. Sahasrara</th>
                                    <td data-health-row="1">-</td>
                                    <td data-health-row="1">-</td>
                                    <td data-health-row="1">-</td>
                                </tr>
                                <tr>
                                    <th scope="row">6.Ajna</th>
                                    <td data-health-row="2">-</td>
                                    <td data-health-row="2">-</td>
                                    <td data-health-row="2">-</td>
                                </tr>
                                <tr>
                                    <th scope="row">5.Vishuddha</th>
                                    <td data-health-row="3">-</td>
                                    <td data-health-row="3">-</td>
                                    <td data-health-row="3">-</td>
                                </tr>
                                <tr>
                                    <th scope="row">4.Anahata</th>
                                    <td data-health-row="4">-</td>
                                    <td data-health-row="4">-</td>
                                    <td data-health-row="4">-</td>
                                </tr>
                                <tr>
                                    <th scope="row">3.Manipura</th>
                                    <td data-health-row="5">-</td>
                                    <td data-health-row="5">-</td>
                                    <td data-health-row="5">-</td>
                                </tr>
                                <tr>
                                    <th scope="row">2.Svadhisthana</th>
                                    <td data-health-row="6">-</td>
                                    <td data-health-row="6">-</td>
                                    <td data-health-row="6">-</td>
                                </tr>
                                <tr>
                                    <th scope="row">1.Muladhara</th>
                                    <td data-health-row="7">-</td>
                                    <td data-health-row="7">-</td>
                                    <td data-health-row="7">-</td>
                                </tr>
                                <tr>
                                    <th scope="row">TOTALE</th>
                                    <td data-health-row="8">-</td>
                                    <td data-health-row="8">-</td>
                                    <td data-health-row="8">-</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <div class="insight-grid">
                    <section class="insight-card" aria-labelledby="ricercaTitolo">
                        <h2 id="ricercaTitolo">Scopo personale</h2>
                        <p>Unione del maschile e femminile.</p>
                        <p>Abilità, capacità, conoscenze.</p>
                        <dl class="value-list">
                            <div>
                                <dt>Cielo</dt>
                                <dd id="valoreCielo">-</dd>
                            </div>
                            <div>
                                <dt>Terra</dt>
                                <dd id="valoreTerra">-</dd>
                            </div>
                            <div class="value-total">
                                <dt class="visually-hidden">Totale calcolato</dt>
                                <dd id="valoreRicercaTotale">-</dd>
                            </div>
                        </dl>
                    </section>

                    <section class="insight-card" aria-labelledby="socializzazioneTitolo">
                        <h2 id="socializzazioneTitolo">Scopo sociale</h2>
                        <p>Sistemi sociali e del clan familiare.</p>
                        <p>Risultati e riconoscimento nella società.</p>
                        <dl class="value-list">
                            <div>
                                <dt>M</dt>
                                <dd id="valoreSocialeM">-</dd>
                            </div>
                            <div>
                                <dt>F</dt>
                                <dd id="valoreSocialeF">-</dd>
                            </div>
                            <div class="value-total">
                                <dt class="visually-hidden">Totale calcolato</dt>
                                <dd id="valoreSocialeTotale">-</dd>
                            </div>
                        </dl>
                    </section>

                    <section class="insight-card insight-card-compact" aria-labelledby="spiritualeTitolo">
                        <h2 id="spiritualeTitolo">Scopo generale</h2>
                        <p>Chi sono io per Dio? Dov'è il divino in me?</p>
                        <dl class="value-list">
                            <div>
                                <dt>Energia</dt>
                                <dd id="valoreSpirituale">-</dd>
                            </div>
                        </dl>
                    </section>

                    <section class="insight-card insight-card-compact" aria-labelledby="planetarioTitolo">
                        <h2 id="planetarioTitolo">Scopo universale</h2>
                        <p>Scopo planetario, cosa dare al mondo, stile di vita.</p>
                        <dl class="value-list">
                            <div>
                                <dt>Energia</dt>
                                <dd id="valorePlanetario">-</dd>
                            </div>
                        </dl>
                    </section>
                </div>
            </section>
        </main>
    </div>
</div>

<a class="back-to-top" href="#top" aria-label="Torna all'inizio della pagina">Torna su</a>

@code {
    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Index.razor.js");
        await module.InvokeVoidAsync("initializeIndexPage");
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.InvokeVoidAsync("disposeIndexPage");
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
